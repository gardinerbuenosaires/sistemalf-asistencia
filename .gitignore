*.xlsx

# Lo que sacan los lectores: tiene HUELLAS y claves numericas de la gente.
# Normalmente cae al lado de la base, en ProgramData, pero si DB_PATH apunta
# adentro del repo --o no esta definido-- termina aca. No sale de la PC.
relevamiento/
borrados/
data/relevamiento/
data/borrados/

# La configuracion exportada de los lectores: tiene las IP y las claves
# de los equipos. Se guarda, se lleva a mano y no va al repo.
accesos-*.json
*.bak

# Claude Code
.claude/

# Capturas de horarios
horarios/

# Logo y archivos subidos (se suben por la UI, no van al repo)
web/static/uploads/*
!web/static/uploads/.gitkeep

# Logs del servidor
*.log
server.log
uvicorn.log
uvicorn_err.log

# Archivos de debug
debug_*.py
